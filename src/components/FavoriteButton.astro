---
import type { CollectionEntry } from 'astro:content';

interface Props {
  recipe: CollectionEntry<'recipes'>;
  variant?: 'large' | 'small';
}
const { recipe, variant = 'large' } = Astro.props;
const data = recipe.data;
const minimal = {
  slug: recipe.slug,
  title: data.title,
  image: data.image,
  description: data.description,
  totalTime: data.totalTime,
  servings: data.servings,
  category: data.category,
};
---
<button
  type="button"
  class={`fav-btn fav-${variant}`}
  data-recipe={JSON.stringify(minimal)}
  aria-label="บันทึกสูตรนี้"
>
  <span class="fav-icon">🤍</span>
  <span class="fav-label">บันทึกสูตรนี้</span>
</button>

<script src={`${import.meta.env.BASE_URL}favorites.js`} is:inline></script>
<script is:inline>
  function syncFavBtns() {
    document.querySelectorAll('.fav-btn').forEach((btn) => {
      try {
        const data = JSON.parse(btn.dataset.recipe);
        const isFav = window.Favorites && window.Favorites.has(data.slug);
        const icon = btn.querySelector('.fav-icon');
        const label = btn.querySelector('.fav-label');
        if (isFav) {
          btn.classList.add('on');
          if (icon) icon.textContent = '❤️';
          if (label) label.textContent = 'บันทึกแล้ว';
        } else {
          btn.classList.remove('on');
          if (icon) icon.textContent = '🤍';
          if (label) label.textContent = 'บันทึกสูตรนี้';
        }
      } catch {}
    });
  }
  function bindFavBtns() {
    document.querySelectorAll('.fav-btn').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          const data = JSON.parse(btn.dataset.recipe);
          window.Favorites.toggle(data);
          syncFavBtns();
        } catch {}
      });
    });
  }
  if (window.Favorites) { bindFavBtns(); syncFavBtns(); }
  else {
    const wait = setInterval(() => {
      if (window.Favorites) { clearInterval(wait); bindFavBtns(); syncFavBtns(); }
    }, 50);
  }
  window.addEventListener('favorites-changed', syncFavBtns);
</script>

<style>
  .fav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: white;
    border: 2px solid var(--color-border);
    color: var(--color-text);
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font-family: var(--font);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .fav-btn:hover {
    border-color: #ef4444;
    color: #b91c1c;
  }
  .fav-btn.on {
    background: #fef2f2;
    border-color: #ef4444;
    color: #b91c1c;
  }
  .fav-icon { font-size: 1.15rem; }

  .fav-small {
    padding: 0.35rem 0.75rem;
    font-size: 0.85rem;
  }
  .fav-small .fav-label { display: none; }
</style>
