---
interface Props {
  currentPage: number;
  totalPages: number;
}
const { currentPage, totalPages } = Astro.props;
const base = import.meta.env.BASE_URL;

function pageUrl(p: number): string {
  if (p <= 1) return base;
  return `${base}page/${p}/`;
}

// คำนวน range ของหน้าที่จะแสดง — truncate เมื่อหน้าเยอะ
function getPageNumbers(current: number, total: number): (number | '…')[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }
  const pages: (number | '…')[] = [1];
  if (current > 3) pages.push('…');
  for (
    let p = Math.max(2, current - 1);
    p <= Math.min(total - 1, current + 1);
    p++
  ) {
    pages.push(p);
  }
  if (current < total - 2) pages.push('…');
  pages.push(total);
  return pages;
}
const pageNumbers = getPageNumbers(currentPage, totalPages);
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="หน้าสูตร">
    <a
      href={hasPrev ? pageUrl(currentPage - 1) : '#'}
      class={`page-btn page-prev ${hasPrev ? '' : 'disabled'}`}
      aria-disabled={!hasPrev}
      tabindex={hasPrev ? 0 : -1}
    >
      ← ก่อนหน้า
    </a>

    <ul class="page-list">
      {pageNumbers.map((p) =>
        p === '…' ? (
          <li class="page-ellipsis" aria-hidden="true">…</li>
        ) : (
          <li>
            {p === currentPage ? (
              <span class="page-num current" aria-current="page">{p}</span>
            ) : (
              <a href={pageUrl(p)} class="page-num" aria-label={`หน้า ${p}`}>
                {p}
              </a>
            )}
          </li>
        )
      )}
    </ul>

    <a
      href={hasNext ? pageUrl(currentPage + 1) : '#'}
      class={`page-btn page-next ${hasNext ? '' : 'disabled'}`}
      aria-disabled={!hasNext}
      tabindex={hasNext ? 0 : -1}
    >
      ถัดไป →
    </a>
  </nav>
)}

<style>
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin: 2.5rem 0 1rem;
    flex-wrap: wrap;
  }

  .page-btn {
    padding: 0.5rem 1rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.92rem;
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .page-btn:hover:not(.disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
    background: #fff7ed;
    text-decoration: none;
  }
  .page-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .page-list {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    align-items: center;
  }

  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 0.5rem;
    border-radius: 50%;
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.15s;
  }
  a.page-num:hover {
    background: #fff7ed;
    color: var(--color-primary-dark);
    text-decoration: none;
  }
  .page-num.current {
    background: var(--color-primary);
    color: white;
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.35);
  }

  .page-ellipsis {
    padding: 0 0.4rem;
    color: var(--color-muted);
    user-select: none;
  }

  /* Mobile: ลดขนาด/ระยะ */
  @media (max-width: 640px) {
    .pagination { gap: 0.5rem; margin: 1.75rem 0 0.5rem; }
    .page-btn { padding: 0.4rem 0.85rem; font-size: 0.88rem; }
    .page-num { min-width: 34px; height: 34px; font-size: 0.9rem; }
    .page-list { gap: 0.15rem; }
  }
</style>
