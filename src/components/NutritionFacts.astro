---
import type { CollectionEntry } from 'astro:content';
import { estimateNutrition, getDailyValuePercent } from '../utils/nutrition';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const data = recipe.data;

// ใช้ค่าจริงถ้าระบุไว้ใน .md, ไม่งั้น estimate
const n = data.nutrition || estimateNutrition(data.ingredients, data.servings);
const isEstimated = !data.nutrition;
---
<section class="nutrition-facts">
  <div class="nf-head">
    <h2>📊 ข้อมูลโภชนาการ</h2>
    <span class="nf-per">ต่อ 1 ที่</span>
  </div>

  <div class="nf-grid">
    <div class="nf-cell highlight">
      <span class="nf-num">{n.calories}</span>
      <span class="nf-unit">kcal</span>
      <span class="nf-label">แคลอรี่</span>
    </div>
    <div class="nf-cell">
      <span class="nf-num">{n.protein}<small>g</small></span>
      <span class="nf-label">โปรตีน</span>
      <span class="nf-dv">{getDailyValuePercent('protein', n.protein)}% DV</span>
    </div>
    <div class="nf-cell">
      <span class="nf-num">{n.carbs}<small>g</small></span>
      <span class="nf-label">คาร์บ</span>
      <span class="nf-dv">{getDailyValuePercent('carbs', n.carbs)}% DV</span>
    </div>
    <div class="nf-cell">
      <span class="nf-num">{n.fat}<small>g</small></span>
      <span class="nf-label">ไขมัน</span>
      <span class="nf-dv">{getDailyValuePercent('fat', n.fat)}% DV</span>
    </div>
    <div class="nf-cell">
      <span class="nf-num">{n.sodium}<small>mg</small></span>
      <span class="nf-label">โซเดียม</span>
      <span class="nf-dv">{getDailyValuePercent('sodium', n.sodium)}% DV</span>
    </div>
    <div class="nf-cell">
      <span class="nf-num">{n.fiber}<small>g</small></span>
      <span class="nf-label">ไฟเบอร์</span>
      <span class="nf-dv">{getDailyValuePercent('fiber', n.fiber)}% DV</span>
    </div>
  </div>

  {isEstimated && (
    <p class="nf-note">
      ℹ️ ค่าเป็นการประมาณการจากวัตถุดิบ — สำหรับข้อมูลที่แม่นยำควรใช้เครื่องชั่งและตารางโภชนาการ
    </p>
  )}
</section>

<style>
  .nutrition-facts {
    background: white;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.5rem;
    border: 1px solid var(--color-border);
  }
  .nf-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .nf-head h2 { margin: 0; font-size: 1.2rem; }
  .nf-per { color: var(--color-muted); font-size: 0.88rem; }

  .nf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 640px) {
    .nf-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .nf-cell {
    background: #fafafa;
    padding: 0.85rem 0.75rem;
    border-radius: 12px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .nf-cell.highlight {
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  }

  .nf-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    line-height: 1.1;
  }
  .nf-num small {
    font-size: 0.85rem;
    font-weight: 600;
    margin-left: 1px;
  }
  .nf-unit {
    font-size: 0.78rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.15rem;
    font-weight: 600;
  }
  .nf-label {
    font-size: 0.85rem;
    color: var(--color-text);
    font-weight: 600;
  }
  .nf-dv {
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .nf-note {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
</style>
