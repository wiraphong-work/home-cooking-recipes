---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="สูตรที่บันทึกไว้ · ครัวบ้านๆ"
  description="รายการสูตรอาหารที่คุณกดหัวใจไว้ บันทึกสูตรโปรดเก็บไว้ทำทีหลัง"
>
  <section class="fav-hero">
    <div class="container">
      <h1>❤️ สูตรที่ฉันบันทึกไว้</h1>
      <p>กดหัวใจสูตรไหน เก็บไว้ที่นี่ — ดูได้ทุกเมื่อ</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div id="emptyView" class="empty-state" hidden>
        <h2>ยังไม่มีสูตรที่บันทึก 🥲</h2>
        <p>กดปุ่ม <strong>🤍 บันทึกสูตรนี้</strong> ใต้สูตรไหนก็ได้ที่ชอบ จะปรากฏที่นี่</p>
        <a href={base} class="cta-btn">ไปดูสูตรอาหาร</a>
      </div>

      <div id="activeView" hidden>
        <div class="head-bar">
          <h2 id="favTitle">บันทึกไว้ (0 สูตร)</h2>
          <button id="clearAllBtn" class="link-btn">ลบทั้งหมด</button>
        </div>
        <div id="favGrid" class="grid"></div>
      </div>
    </div>
  </section>

  <script src={`${base}favorites.js`} is:inline></script>
  <script is:inline define:vars={{ base }}>
    function escape(s) {
      return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
    }
    function formatTime(iso) {
      const m = (iso || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
      if (!m) return iso;
      const h = parseInt(m[1] || '0'), mi = parseInt(m[2] || '0');
      if (h > 0 && mi > 0) return `${h} ชม. ${mi} นาที`;
      if (h > 0) return `${h} ชั่วโมง`;
      return `${mi} นาที`;
    }
    function render() {
      const list = window.Favorites.get();
      const empty = document.getElementById('emptyView');
      const active = document.getElementById('activeView');
      if (list.length === 0) { empty.hidden = false; active.hidden = true; return; }
      empty.hidden = true; active.hidden = false;
      document.getElementById('favTitle').textContent = `บันทึกไว้ (${list.length} สูตร)`;
      document.getElementById('favGrid').innerHTML = list.map((r) => `
        <div class="fav-card-wrap">
          <a href="${base}recipes/${r.slug}/" class="card">
            <div class="card-image">
              <img src="${escape(r.image)}" alt="${escape(r.title)}" loading="lazy" />
            </div>
            <div class="card-body">
              <h3>${escape(r.title)}</h3>
              <p>${escape(r.description)}</p>
              <div class="meta">
                <span>⏱️ ${formatTime(r.totalTime)}</span>
                <span>🍽️ ${r.servings} ที่</span>
              </div>
            </div>
          </a>
          <button class="fav-remove" data-slug="${escape(r.slug)}" aria-label="ลบจากบันทึก">×</button>
        </div>
      `).join('');
      document.querySelectorAll('.fav-remove').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          window.Favorites.remove(btn.dataset.slug);
        });
      });
    }
    function init() {
      render();
      window.addEventListener('favorites-changed', render);
      document.getElementById('clearAllBtn').addEventListener('click', () => {
        if (confirm('ลบสูตรที่บันทึกทั้งหมด?')) {
          localStorage.removeItem('favorites');
          window.dispatchEvent(new CustomEvent('favorites-changed'));
        }
      });
    }
    if (window.Favorites) init();
    else {
      const w = setInterval(() => { if (window.Favorites) { clearInterval(w); init(); } }, 50);
    }
  </script>

  <style>
    .fav-hero {
      background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
      padding: 2.25rem 1.25rem 1.5rem;
      text-align: center;
    }
    .fav-hero h1 {
      font-size: 2rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.4rem;
    }
    .fav-hero p { color: var(--color-muted); margin: 0; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: var(--color-muted); }
    .empty-state h2 { font-size: 1.4rem; margin-bottom: 0.5rem; }
    .empty-state p { margin-bottom: 1.5rem; }
    .cta-btn {
      display: inline-block;
      background: var(--color-primary);
      color: white !important;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      font-weight: 700;
    }
    .head-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .head-bar h2 { margin: 0; font-size: 1.3rem; }
    .link-btn {
      background: white;
      border: 1px solid var(--color-border);
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      cursor: pointer;
      font-family: var(--font);
      font-size: 0.88rem;
    }
    .link-btn:hover { border-color: #ef4444; color: #b91c1c; }
    .fav-card-wrap { position: relative; }
    .fav-remove {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(0,0,0,0.6);
      color: white;
      border: none;
      cursor: pointer;
      font-size: 1.3rem;
      line-height: 1;
      z-index: 2;
    }
    .fav-remove:hover { background: rgba(239, 68, 68, 0.9); }
  </style>
</BaseLayout>
