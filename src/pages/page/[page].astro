---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 30;

export async function getStaticPaths() {
  const allRecipes = await getCollection('recipes');
  const sorted = allRecipes.sort((a, b) =>
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  );
  const totalPages = Math.ceil(sorted.length / 30);

  // สร้างเฉพาะหน้า 2 ขึ้นไป (หน้า 1 อยู่ที่ index.astro)
  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    const start = (p - 1) * 30;
    paths.push({
      params: { page: String(p) },
      props: {
        recipes: sorted.slice(start, start + 30),
        currentPage: p,
        totalPages,
        totalRecipes: sorted.length,
      },
    });
  }
  return paths;
}

const { recipes, currentPage, totalPages, totalRecipes } = Astro.props;
const base = import.meta.env.BASE_URL;

function formatTime(iso: string): string {
  const m = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
  if (!m) return iso;
  const h = parseInt(m[1] || '0');
  const mi = parseInt(m[2] || '0');
  if (h > 0 && mi > 0) return `${h} ชม. ${mi} นาที`;
  if (h > 0) return `${h} ชั่วโมง`;
  return `${mi} นาที`;
}
---
<BaseLayout
  title={`สูตรอาหารไทย หน้า ${currentPage} · ครัวบ้านๆ`}
  description={`รวมสูตรอาหารไทยทำง่าย หน้า ${currentPage} จาก ${totalPages} · ทั้งหมด ${totalRecipes} สูตร`}
>
  <section class="page-hero">
    <div class="container">
      <h1>สูตรอาหารไทย — หน้า {currentPage}</h1>
      <p>หน้า {currentPage} จาก {totalPages} · ทั้งหมด {totalRecipes} สูตร</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid">
        {recipes.map((recipe) => (
          <RecipeCard
            href={`${base}recipes/${recipe.slug}/`}
            title={recipe.data.title}
            description={recipe.data.description}
            image={recipe.data.image}
            cookTime={formatTime(recipe.data.totalTime)}
            servings={recipe.data.servings}
          />
        ))}
      </div>

      <Pagination currentPage={currentPage} totalPages={totalPages} />
    </div>
  </section>

  <style>
    .page-hero {
      background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
      padding: 2rem 1.25rem 1.5rem;
      text-align: center;
    }
    .page-hero h1 {
      font-size: 1.85rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.4rem;
    }
    .page-hero p {
      color: var(--color-muted);
      font-size: 0.98rem;
      margin: 0;
    }
    @media (max-width: 640px) {
      .page-hero { padding: 1.5rem 0.875rem 1.1rem; }
      .page-hero h1 { font-size: 1.4rem; }
      .page-hero p { font-size: 0.9rem; }
    }
  </style>
</BaseLayout>
