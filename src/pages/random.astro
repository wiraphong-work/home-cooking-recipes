---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getMeals, MEAL_INFO, type Meal } from '../utils/meal';

const base = import.meta.env.BASE_URL;
const allRecipes = await getCollection('recipes');

// แปลงข้อมูลที่จำเป็นสำหรับ client side สุ่ม
const recipesData = allRecipes.map((r) => ({
  slug: r.slug,
  title: r.data.title,
  description: r.data.description,
  image: r.data.image,
  totalTime: r.data.totalTime,
  servings: r.data.servings,
  category: r.data.category,
  meals: getMeals(r.data),
}));

const meals: Meal[] = ['เช้า', 'กลางวัน', 'เย็น', 'ของว่าง'];
---
<BaseLayout
  title="สุ่มเมนูอาหาร · วันนี้กินอะไรดี | ครัวบ้านๆ"
  description="คิดไม่ออกว่ากินอะไรดี? กดปุ่มสุ่มเมนูอาหารไทยทำง่าย เลือกตามมื้อเช้า กลางวัน หรือเย็น สุ่มหลายเมนูพร้อมกันได้"
>
  <section class="random-hero">
    <div class="container">
      <h1>🎲 วันนี้กินอะไรดี?</h1>
      <p>กดปุ่มเพื่อสุ่มเมนูที่คุณอาจอยากลอง วันนี้!</p>

      <!-- Filter ตามมื้อ -->
      <div class="meal-filter" id="mealFilter">
        <button class="meal-btn active" data-meal="all">🍽️ ทุกมื้อ</button>
        {meals.map((m) => (
          <button class="meal-btn" data-meal={m}>
            {MEAL_INFO[m].emoji} {MEAL_INFO[m].label}
          </button>
        ))}
      </div>

      <!-- Tab จำนวนเมนู -->
      <div class="count-tabs" id="countTabs">
        <span class="count-label">จำนวนเมนู</span>
        <button class="count-btn active" data-count="1">1 เมนู</button>
        <button class="count-btn" data-count="2">2 เมนู</button>
        <button class="count-btn" data-count="3">3 เมนู</button>
      </div>
    </div>
  </section>

  <section class="section random-section">
    <div class="container">
      <!-- Slot Machines (1-3 reels) -->
      <div class="slots-grid" id="slotsGrid" data-count="1">
        <!-- Reels จะถูก inject ด้วย JS -->
      </div>

      <div class="slot-actions">
        <button id="spinBtn" class="spin-btn">
          <span class="spin-emoji">🎲</span>
          <span id="spinLabel">สุ่มเมนู!</span>
        </button>
      </div>

      <p class="slot-hint" id="slotHint">เลือกมื้อด้านบน แล้วกดปุ่มสุ่มได้เลย</p>
    </div>
  </section>

  <script is:inline define:vars={{ recipesData, base }}>
    // ===== State =====
    let currentMeal = 'all';
    let currentCount = 1;
    let currentPicks = []; // recipe สุดท้ายในแต่ละ reel
    let spinning = false;

    // ===== Helpers =====
    function formatTime(iso) {
      const m = (iso || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
      if (!m) return iso;
      const h = parseInt(m[1] || '0');
      const min = parseInt(m[2] || '0');
      if (h > 0 && min > 0) return `${h} ชม. ${min} นาที`;
      if (h > 0) return `${h} ชั่วโมง`;
      return `${min} นาที`;
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function getFiltered() {
      if (currentMeal === 'all') return recipesData;
      return recipesData.filter((r) => r.meals.includes(currentMeal));
    }

    function pickRandom(arr, excludeSlugs) {
      if (arr.length === 0) return null;
      const exclude = new Set(excludeSlugs || []);
      const pool = arr.filter((r) => !exclude.has(r.slug));
      if (pool.length === 0) return arr[Math.floor(Math.random() * arr.length)];
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function pickN(arr, n, excludePrev) {
      // เลือก n สูตรที่ไม่ซ้ำกัน หลีกเลี่ยง excludePrev เป็นอันดับแรก
      const result = [];
      const used = new Set();
      const prevSet = new Set(excludePrev || []);

      // Pass 1: หาสูตรที่ไม่ใช่ของรอบก่อน
      const pool1 = arr.filter((r) => !prevSet.has(r.slug));
      while (result.length < n && pool1.length > 0) {
        const idx = Math.floor(Math.random() * pool1.length);
        const pick = pool1.splice(idx, 1)[0];
        if (!used.has(pick.slug)) {
          result.push(pick);
          used.add(pick.slug);
        }
      }

      // Pass 2: ถ้ายังไม่ครบ ดึงจากของรอบก่อนได้ (กรณีสูตรน้อย)
      if (result.length < n) {
        const pool2 = arr.filter((r) => !used.has(r.slug));
        while (result.length < n && pool2.length > 0) {
          const idx = Math.floor(Math.random() * pool2.length);
          const pick = pool2.splice(idx, 1)[0];
          result.push(pick);
          used.add(pick.slug);
        }
      }
      return result;
    }

    // ===== Render =====
    function renderCard(recipe) {
      if (!recipe) {
        return `<div class="slot-card empty">ไม่มีสูตรในหมวดนี้<br/>ลองเลือกมื้ออื่น</div>`;
      }
      // ทั้งใบเป็น <a> คลิกได้ทุกที่
      // inline style บน img เพราะ Astro scoped CSS ไม่ apply กับ innerHTML
      const imgStyle = 'position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center;display:block;aspect-ratio:auto;';
      return `
        <a class="slot-card" href="${base}recipes/${recipe.slug}/" aria-label="ดูสูตร ${escapeHtml(recipe.title)}">
          <div class="slot-img" style="position:relative;overflow:hidden;background:#fee2c8;flex:0 0 240px;width:100%;">
            <img src="${escapeHtml(recipe.image)}" alt="${escapeHtml(recipe.title)}" decoding="async" style="${imgStyle}" />
          </div>
          <div class="slot-card-body">
            <h2 class="slot-title">${escapeHtml(recipe.title)}</h2>
            <p class="slot-desc">${escapeHtml(recipe.description)}</p>
            <div class="slot-footer">
              <div class="slot-meta">
                <span>⏱️ ${formatTime(recipe.totalTime)}</span>
                <span>🍽️ ${recipe.servings} ที่</span>
              </div>
              <span class="cat-chip">${escapeHtml(recipe.category)}</span>
            </div>
          </div>
        </a>
      `;
    }

    function renderReel(idx, recipe) {
      return `
        <div class="slot-frame" data-idx="${idx}">
          <div class="slot-reel">
            ${renderCard(recipe)}
          </div>
        </div>
      `;
    }

    function renderAllReels(picks) {
      const grid = document.getElementById('slotsGrid');
      grid.dataset.count = String(currentCount);
      const html = [];
      for (let i = 0; i < currentCount; i++) {
        html.push(renderReel(i, picks[i]));
      }
      grid.innerHTML = html.join('');
    }

    // ===== Preload images — กันรูปกระตุก =====
    const _preloadedSet = new Set();
    function preloadAll() {
      recipesData.forEach((r) => {
        if (_preloadedSet.has(r.image)) return;
        const im = new Image();
        im.src = r.image;
        _preloadedSet.add(r.image);
      });
    }

    // อัพเดทเฉพาะเนื้อหาใน reel ระหว่าง animation (ไม่สร้างกรอบใหม่)
    function updateReelContent(idx, recipe, flash) {
      const frame = document.querySelector(`.slot-frame[data-idx="${idx}"]`);
      if (!frame) return;
      const reel = frame.querySelector('.slot-reel');
      reel.innerHTML = renderCard(recipe);
      if (flash) {
        reel.classList.remove('flash');
        void reel.offsetWidth;
        reel.classList.add('flash');
      }
    }

    function lockReels() {
      document.querySelectorAll('.slot-reel').forEach((reel) => {
        reel.classList.add('locked');
        setTimeout(() => reel.classList.remove('locked'), 1200);
      });
    }

    // ===== Spin =====
    async function spin() {
      if (spinning) return;
      const filtered = getFiltered();
      if (filtered.length === 0) {
        renderAllReels([null]);
        document.getElementById('slotHint').textContent =
          'ไม่มีสูตรในหมวดนี้ ลองเลือกมื้ออื่น';
        return;
      }

      spinning = true;
      const spinBtn = document.getElementById('spinBtn');
      const spinLabel = document.getElementById('spinLabel');
      const hint = document.getElementById('slotHint');
      const grid = document.getElementById('slotsGrid');

      grid.classList.add('is-spinning');
      spinBtn.classList.add('spinning');
      spinBtn.disabled = true;
      spinLabel.textContent = 'กำลังสุ่ม...';
      hint.textContent = '';

      const prevSlugs = currentPicks.map((p) => p && p.slug).filter(Boolean);
      const finalPicks = pickN(filtered, currentCount, prevSlugs);

      // ถ้ายังไม่มี reels (รอบแรก) ให้ render กรอบก่อน
      if (document.querySelectorAll('.slot-frame').length !== currentCount) {
        renderAllReels(new Array(currentCount).fill(null));
      }

      const totalSpins = 14 + Math.floor(Math.random() * 4);
      const baseDelay = 50;

      for (let i = 0; i < totalSpins; i++) {
        const isLast = i === totalSpins - 1;
        for (let j = 0; j < currentCount; j++) {
          const recipe = isLast ? finalPicks[j] : pickRandom(filtered, []);
          updateReelContent(j, recipe, true);
        }
        const progress = i / totalSpins;
        const delay = baseDelay + Math.pow(progress, 2) * 380;
        await new Promise((r) => setTimeout(r, delay));
      }

      currentPicks = finalPicks;
      lockReels();

      spinLabel.textContent = '🔄 สุ่มอีกครั้ง';
      spinBtn.classList.remove('spinning');
      spinBtn.disabled = false;
      grid.classList.remove('is-spinning');
      hint.textContent = `จาก ${filtered.length} เมนูในหมวดนี้`;
      spinning = false;
    }

    // ===== Filter buttons =====
    document.querySelectorAll('#mealFilter .meal-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (spinning) return;
        document.querySelectorAll('#mealFilter .meal-btn').forEach((b) =>
          b.classList.remove('active')
        );
        btn.classList.add('active');
        currentMeal = btn.dataset.meal;
        const filtered = getFiltered();
        document.getElementById('slotHint').textContent =
          `มี ${filtered.length} เมนูในหมวดนี้ — กดสุ่มได้เลย`;
      });
    });

    // ===== Count tabs =====
    document.querySelectorAll('#countTabs .count-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (spinning) return;
        document.querySelectorAll('#countTabs .count-btn').forEach((b) =>
          b.classList.remove('active')
        );
        btn.classList.add('active');
        currentCount = parseInt(btn.dataset.count);
        // เปลี่ยนจำนวน reels ทันที — เริ่มต้นด้วย empty slot
        const filtered = getFiltered();
        const initial = pickN(filtered, currentCount, []);
        currentPicks = initial;
        renderAllReels(initial);
        document.getElementById('slotHint').textContent =
          `พร้อมสุ่ม ${currentCount} เมนู — กดปุ่มได้เลย`;
      });
    });

    // ===== Spin button =====
    document.getElementById('spinBtn').addEventListener('click', spin);

    // ===== Init: แสดงเมนูประจำวันเป็น preview =====
    (function init() {
      const today = new Date();
      const start = Date.UTC(today.getUTCFullYear(), 0, 0);
      const dayOfYear = Math.floor((today.getTime() - start) / 86400000);
      const seed = (dayOfYear * 31 + today.getUTCFullYear() * 7) % recipesData.length;
      currentPicks = [recipesData[seed]];
      renderAllReels(currentPicks);
      // Preload รูปทั้งหมด — ระหว่างสุ่มจะไม่กระตุก
      if ('requestIdleCallback' in window) {
        requestIdleCallback(preloadAll, { timeout: 1500 });
      } else {
        setTimeout(preloadAll, 300);
      }
    })();
  </script>

  <style is:global>
    .random-hero {
      background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
      padding: 2.5rem 1.25rem 1.5rem;
      text-align: center;
    }
    .random-hero h1 {
      font-size: 2.5rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.5rem;
    }
    .random-hero p {
      color: var(--color-muted);
      font-size: 1.05rem;
      margin-bottom: 1.5rem;
    }
    @media (max-width: 640px) {
      .random-hero { padding: 2rem 0.875rem 1.25rem; }
      .random-hero h1 { font-size: 1.75rem; }
      .random-hero p { font-size: 0.95rem; }
    }

    /* ===== Filter & Tabs ===== */
    .meal-filter,
    .count-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }
    .meal-filter { margin-bottom: 0.875rem; }
    .count-tabs { margin-top: 0.25rem; }

    .count-label {
      font-size: 0.92rem;
      color: var(--color-muted);
      margin-right: 0.25rem;
    }

    .meal-btn,
    .count-btn {
      background: white;
      border: 2px solid var(--color-border);
      color: var(--color-text);
      padding: 0.5rem 1rem;
      border-radius: 999px;
      cursor: pointer;
      font-family: var(--font);
      font-size: 0.95rem;
      font-weight: 500;
      transition: all 0.15s;
    }
    .count-btn { padding: 0.4rem 0.95rem; font-size: 0.9rem; }
    .meal-btn:hover,
    .count-btn:hover {
      border-color: var(--color-primary);
      transform: translateY(-1px);
    }
    .meal-btn.active,
    .count-btn.active {
      background: var(--color-primary);
      border-color: var(--color-primary);
      color: white;
    }
    @media (max-width: 640px) {
      .meal-btn { padding: 0.4rem 0.85rem; font-size: 0.88rem; }
      .count-btn { padding: 0.35rem 0.85rem; font-size: 0.85rem; }
    }

    /* ===== Slot Grid (1-3 reels) ===== */
    .random-section { padding-top: 1.75rem; }

    .slots-grid {
      display: grid;
      gap: 1.25rem;
      max-width: 100%;
      margin: 0 auto;
    }
    .slots-grid[data-count="1"] {
      grid-template-columns: minmax(0, 560px);
      justify-content: center;
    }
    .slots-grid[data-count="2"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 900px;
    }
    .slots-grid[data-count="3"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 1100px;
    }

    /* Mobile: stack ลงเป็น 1 คอลัมน์ */
    @media (max-width: 820px) {
      .slots-grid[data-count="2"],
      .slots-grid[data-count="3"] {
        grid-template-columns: minmax(0, 480px);
        justify-content: center;
        max-width: 100%;
      }
    }

    /* ===== Slot Frame (orange casing) ===== */
    .slot-frame {
      background: linear-gradient(180deg, #fdba74 0%, #f97316 100%);
      padding: 0.75rem;
      border-radius: 22px;
      box-shadow: 0 12px 32px rgba(234, 88, 12, 0.22);
      display: flex;
      flex-direction: column;
    }

    /* ===== Slot Reel (FIXED PIXEL HEIGHT — ไม่ยืด) ===== */
    .slot-reel {
      background: white;
      border-radius: 14px;
      overflow: hidden;
      width: 100%;
      height: 480px;          /* lock ความสูงตายตัว */
      display: flex;
      flex-direction: column;
    }
    .slot-reel.flash {
      animation: flash 0.18s ease-out;
    }
    .slot-reel.locked {
      animation: locked 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes flash {
      0%   { opacity: 0.35; filter: blur(2px); }
      100% { opacity: 1; filter: blur(0); }
    }
    @keyframes locked {
      0%   { box-shadow: 0 0 0 0 rgba(249,115,22,0.7); }
      50%  { box-shadow: 0 0 0 12px rgba(249,115,22,0); }
      100% { box-shadow: 0 0 0 0 rgba(249,115,22,0); }
    }

    /* ===== Slot Card (เต็ม reel เสมอ + คลิกได้ทั้งใบ) ===== */
    .slot-card {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      transition: transform 0.15s;
    }
    .slot-card:hover {
      text-decoration: none;
    }
    .slot-card:hover .slot-title {
      color: var(--color-primary-dark);
    }
    /* ระหว่างหมุน — กันคลิก */
    .slots-grid.is-spinning .slot-card {
      pointer-events: none;
      cursor: wait;
    }

    .slot-img {
      flex: 0 0 240px;             /* รูปสูงตายตัว 240px */
      width: 100%;
      overflow: hidden;
      background: #fee2c8;
      position: relative;          /* anchor ให้รูปข้างใน */
    }
    .slot-img img {
      position: absolute;
      inset: 0;                    /* top/right/bottom/left = 0 */
      width: 100% !important;
      height: 100% !important;
      max-width: none;
      object-fit: cover !important;
      object-position: center;
      aspect-ratio: auto;           /* override implicit ratio จาก width/height attrs */
      display: block;
      transition: transform 0.4s ease;
    }
    .slot-card:hover .slot-img img {
      transform: scale(1.04);
    }

    .slot-card-body {
      flex: 1 1 auto;          /* กินพื้นที่ที่เหลือ (480-240=240px) */
      padding: 1rem 1.1rem 1.1rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      overflow: hidden;
      min-height: 0;
    }

    /* Title: จำกัด 2 บรรทัด */
    .slot-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin: 0;
      color: var(--color-text);
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: calc(1.35em * 2);
    }

    /* Description: จำกัด 2 บรรทัด */
    .slot-desc {
      color: var(--color-muted);
      font-size: 0.88rem;
      margin: 0;
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: calc(1.5em * 2);
    }

    /* Footer row — meta + chip ในบรรทัดเดียว */
    .slot-footer {
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding-top: 0.6rem;
      border-top: 1px solid #f3e8d8;
    }

    .slot-meta {
      display: flex;
      gap: 0.85rem;
      font-size: 0.82rem;
      color: var(--color-muted);
      white-space: nowrap;
      overflow: hidden;
      flex-shrink: 1;
    }

    .cat-chip {
      flex-shrink: 0;
      background: #fff7ed;
      color: var(--color-primary-dark);
      padding: 0.22rem 0.7rem;
      border-radius: 999px;
      font-size: 0.74rem;
      font-weight: 600;
      max-width: 50%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .slot-card.empty {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
      color: var(--color-muted);
      text-align: center;
      width: 100%;
      height: 100%;
    }

    /* ===== Main spin button (กลาง, อันใหญ่) ===== */
    .slot-actions {
      display: flex;
      justify-content: center;
      margin-top: 1.5rem;
    }
    .spin-btn {
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      border: none;
      padding: 0.95rem 2rem;
      border-radius: 999px;
      font-family: var(--font);
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
      box-shadow: 0 6px 18px rgba(234, 88, 12, 0.35);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .spin-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(234, 88, 12, 0.45);
    }
    .spin-btn:disabled { cursor: not-allowed; opacity: 0.85; }
    .spin-btn.spinning .spin-emoji {
      display: inline-block;
      animation: dice-roll 0.5s linear infinite;
    }
    @keyframes dice-roll {
      0%   { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .slot-hint {
      margin-top: 1rem;
      color: var(--color-muted);
      font-size: 0.92rem;
      text-align: center;
      min-height: 1.5em;
    }

    /* Tablet: lock ความสูง reel ให้เล็กลงนิด */
    @media (max-width: 820px) {
      .slot-reel { height: 460px; }
      .slot-img { flex: 0 0 220px; }
    }

    /* Mobile: ลดขนาด text + lock height ตายตัวเช่นกัน */
    @media (max-width: 640px) {
      .slot-reel { height: 440px; }
      .slot-img { flex: 0 0 200px; }
      .slot-title { font-size: 1rem; }
      .slot-desc { font-size: 0.82rem; }
