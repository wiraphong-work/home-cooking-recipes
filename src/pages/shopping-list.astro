---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="รายการซื้อของ · ครัวบ้านๆ"
  description="รวมวัตถุดิบจากสูตรที่เลือกไว้ พร้อมลิงก์ซื้อออนไลน์"
>
  <section class="sl-hero">
    <div class="container">
      <h1>🛒 รายการซื้อของ</h1>
      <p>เลือกสูตร → รวมวัตถุดิบทั้งหมด → กดลิงก์ซื้อออนไลน์</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Empty state -->
      <div id="emptyView" class="empty-state" hidden>
        <h2>ยังไม่มีสูตรในรายการ 🥲</h2>
        <p>เลือกสูตรที่อยากทำ กดปุ่ม <strong>🛒 เพิ่มลงรายการซื้อ</strong> ใต้ชื่อสูตร</p>
        <a href={base} class="cta-btn">ไปดูสูตรอาหาร</a>
      </div>

      <!-- Active view -->
      <div id="activeView" hidden>
        <!-- Recipes selected -->
        <section class="sl-section">
          <div class="sl-head">
            <h2 id="recipesTitle">สูตรที่เลือก (0)</h2>
            <button id="clearAllBtn" class="link-btn">ลบทั้งหมด</button>
          </div>
          <div id="recipesList" class="sl-recipes"></div>
        </section>

        <!-- Ingredients aggregated -->
        <section class="sl-section">
          <div class="sl-head">
            <h2 id="ingredientsTitle">วัตถุดิบทั้งหมด (0 อย่าง)</h2>
            <button id="printBtn" class="link-btn">🖨️ พิมพ์</button>
          </div>
          <div id="ingredientsList" class="sl-ingredients"></div>
        </section>

        <!-- Affiliate hint -->
        <div class="affiliate-hint">
          <strong>💡 เคล็ดลับ:</strong> วัตถุดิบที่มีปุ่ม <span class="hint-buy">"ซื้อออนไลน์"</span>
          กดได้เลย จะนำไปร้าน Shopee สั่งซื้อโดยตรง
        </div>
      </div>
    </div>
  </section>

  <script src={`${base}shopping-list.js`} is:inline></script>
  <script is:inline define:vars={{ base }}>
    function escape(s) {
      return String(s).replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c])
      );
    }

    function render() {
      const list = window.ShoppingList.get();
      const empty = document.getElementById('emptyView');
      const active = document.getElementById('activeView');

      if (list.length === 0) {
        empty.hidden = false;
        active.hidden = true;
        return;
      }
      empty.hidden = true;
      active.hidden = false;

      // Render recipes
      document.getElementById('recipesTitle').textContent =
        `สูตรที่เลือก (${list.length})`;

      document.getElementById('recipesList').innerHTML = list.map((r) => `
        <div class="sl-recipe-item">
          <a href="${base}recipes/${r.slug}/" class="sl-recipe-link">
            <img src="${escape(r.image)}" alt="${escape(r.title)}" />
            <div class="sl-recipe-info">
              <strong>${escape(r.title)}</strong>
              <span>${r.ingredients.length} วัตถุดิบ</span>
            </div>
          </a>
          <button class="remove-btn" data-slug="${escape(r.slug)}" aria-label="ลบ">×</button>
        </div>
      `).join('');

      // Bind remove buttons
      document.querySelectorAll('.remove-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          window.ShoppingList.remove(btn.dataset.slug);
        });
      });

      // Aggregate ingredients
      const items = window.ShoppingList.aggregate();
      document.getElementById('ingredientsTitle').textContent =
        `วัตถุดิบทั้งหมด (${items.length} อย่าง)`;

      // แยกที่ซื้อออนไลน์ได้ vs ของสด
      const online = items.filter((i) => i.buyUrl && i.buyUrl !== '');
      const fresh = items.filter((i) => !i.buyUrl || i.buyUrl === '');

      let html = '';
      if (online.length > 0) {
        html += `<h3 class="sl-subtitle">🛍️ ซื้อออนไลน์ได้ <span>(${online.length})</span></h3>`;
        html += '<ul class="sl-list online">';
        online.forEach((i) => {
          html += `
            <li>
              <div class="sl-item-info">
                <strong>${escape(i.name)}</strong>
                <span class="sl-amounts">${i.amounts.map(escape).join(' + ')}</span>
                <span class="sl-from">จาก: ${i.fromRecipes.map(escape).join(', ')}</span>
              </div>
              <a href="${escape(i.buyUrl)}" target="_blank" rel="nofollow sponsored noopener" class="buy-online">
                ซื้อ Shopee →
              </a>
            </li>
          `;
        });
        html += '</ul>';
      }

      if (fresh.length > 0) {
        html += `<h3 class="sl-subtitle">🥬 ซื้อในตลาด <span>(${fresh.length})</span></h3>`;
        html += '<ul class="sl-list fresh">';
        fresh.forEach((i) => {
          html += `
            <li>
              <div class="sl-item-info">
                <strong>${escape(i.name)}</strong>
                <span class="sl-amounts">${i.amounts.map(escape).join(' + ')}</span>
                <span class="sl-from">จาก: ${i.fromRecipes.map(escape).join(', ')}</span>
              </div>
            </li>
          `;
        });
        html += '</ul>';
      }

      document.getElementById('ingredientsList').innerHTML = html;
    }

    function init() {
      render();
      window.addEventListener('shopping-list-changed', render);

      document.getElementById('clearAllBtn').addEventListener('click', () => {
        if (confirm('ลบสูตรในรายการทั้งหมด?')) {
          window.ShoppingList.clear();
        }
      });

      document.getElementById('printBtn').addEventListener('click', () => {
        window.print();
      });
    }

    if (window.ShoppingList) init();
    else {
      const wait = setInterval(() => {
        if (window.ShoppingList) {
          clearInterval(wait);
          init();
        }
      }, 50);
    }
  </script>

  <style>
    .sl-hero {
      background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
      padding: 2rem 1.25rem 1.5rem;
      text-align: center;
    }
    .sl-hero h1 {
      font-size: 2rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.4rem;
    }
    .sl-hero p {
      color: var(--color-muted);
      margin: 0;
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--color-muted);
    }
    .empty-state h2 { margin-bottom: 0.5rem; font-size: 1.4rem; }
    .empty-state p { margin-bottom: 1.5rem; }
    .cta-btn {
      display: inline-block;
      background: var(--color-primary);
      color: white !important;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      font-weight: 700;
      text-decoration: none;
    }

    .sl-section { margin-bottom: 2.5rem; }
    .sl-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .sl-head h2 { margin: 0; font-size: 1.3rem; }
    .link-btn {
      background: white;
      border: 1px solid var(--color-border);
      color: var(--color-text);
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      cursor: pointer;
      font-family: var(--font);
      font-size: 0.88rem;
      transition: border-color 0.15s;
    }
    .link-btn:hover { border-color: var(--color-primary); }

    /* Recipe items */
    .sl-recipes {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
      gap: 0.85rem;
    }
    .sl-recipe-item {
      position: relative;
      background: white;
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .sl-recipe-link {
      display: flex;
      gap: 0.85rem;
      align-items: center;
      padding: 0.6rem 2.5rem 0.6rem 0.6rem;
      color: inherit;
      text-decoration: none;
    }
    .sl-recipe-link img {
      width: 64px;
      height: 64px;
      object-fit: cover;
      border-radius: 8px;
      flex-shrink: 0;
    }
    .sl-recipe-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      min-width: 0;
    }
    .sl-recipe-info strong {
      font-size: 0.95rem;
      line-height: 1.3;
      color: var(--color-text);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .sl-recipe-info span {
      font-size: 0.82rem;
      color: var(--color-muted);
    }
    .remove-btn {
      position: absolute;
      top: 50%;
      right: 0.6rem;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #fee2e2;
      color: #991b1b;
      border: none;
      cursor: pointer;
      font-size: 1.4rem;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .remove-btn:hover { background: #fecaca; }

    /* Ingredients */
    .sl-subtitle {
      font-size: 1.05rem;
      margin: 1.5rem 0 0.75rem;
      color: var(--color-text);
    }
    .sl-subtitle span { color: var(--color-muted); font-weight: normal; }
    .sl-list {
      list-style: none;
      padding: 0;
      background: white;
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .sl-list li {
      display: flex;
      gap: 1rem;
      align-items: center;
      padding: 0.85rem 1rem;
      border-bottom: 1px dashed var(--color-border);
      flex-wrap: wrap;
    }
    .sl-list li:last-child { border-bottom: none; }
    .sl-item-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
    }
    .sl-item-info strong {
      font-size: 0.98rem;
      color: var(--color-text);
    }
    .sl-amounts {
      font-size: 0.9rem;
      color: var(--color-primary-dark);
      font-weight: 600;
    }
    .sl-from {
      font-size: 0.78rem;
      color: var(--color-muted);
    }

    .buy-online {
      background: linear-gradient(135deg, #f97316, #ea580c);
      color: white !important;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      box-shadow: 0 2px 8px rgba(234, 88, 12, 0.3);
    }
    .buy-online:hover { filter: brightness(0.95); text-decoration: none; }

    .affiliate-hint {
      background: #fef3c7;
      color: #92400e;
      padding: 1rem 1.25rem;
      border-radius: 12px;
      font-size: 0.9rem;
      line-height: 1.5;
      margin-top: 1.5rem;
    }
    .hint-buy {
      background: white;
      padding: 0.1rem 0.5rem;
      border-radius: 4px;
      color: var(--color-primary-dark);
      font-weight: 600;
    }

    /* Print */
    @media print {
      .sl-hero, .sl-head .link-btn, .remove-btn, .affiliate-hint, .buy-online {
        display: none !important;
      }
      .sl-list { box-shadow: none; }
    }

    @media (max-width: 640px) {
      .sl-hero h1 { font-size: 1.6rem; }
      .sl-list li { padding: 0.7rem 0.85rem; }
      .buy-online { padding: 0.4rem 0.85rem; font-size: 0.82rem; }
    }
  </style>
</BaseLayout>
