---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SEASONAL_COLLECTIONS, recipeMatchesCollection, isCollectionActiveNow } from '../../utils/seasonal';

const base = import.meta.env.BASE_URL;
const allRecipes = await getCollection('recipes');

const collections = SEASONAL_COLLECTIONS.map((c) => {
  const matches = allRecipes.filter((r) => recipeMatchesCollection(r.data, c));
  const sample = matches[0]?.data.image || allRecipes[0]?.data.image;
  return {
    ...c,
    count: matches.length,
    sampleImage: sample,
    activeNow: isCollectionActiveNow(c),
  };
}).sort((a, b) => Number(b.activeNow) - Number(a.activeNow) || b.count - a.count);
---
<BaseLayout
  title="คอลเลคชันสูตรตามฤดูกาล · ครัวบ้านๆ"
  description="รวมเมนูตามฤดูกาลและเทศกาล สงกรานต์ หน้าฝน หน้าหนาว เมนูทำง่าย เมนูเด็ก"
>
  <section class="se-hero">
    <div class="container">
      <h1>📅 คอลเลคชันสูตรตามฤดูกาล</h1>
      <p>เลือกตามฤดูกาล โอกาส หรือสไตล์ — เราจัดให้แล้ว</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="se-grid">
        {collections.map((c) => (
          <a href={`${base}seasonal/${c.slug}/`} class="se-card">
            <div class="se-thumb">
              <img src={c.sampleImage} alt={c.title} loading="lazy" />
              <div class="se-overlay">
                <span class="se-emoji">{c.emoji}</span>
                {c.activeNow && <span class="se-now">ตอนนี้</span>}
              </div>
            </div>
            <div class="se-body">
              <h2>{c.title}</h2>
              <p>{c.description}</p>
              <span class="se-count">{c.count} สูตร →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .se-hero {
      background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
      padding: 2.25rem 1.25rem 1.5rem;
      text-align: center;
    }
    .se-hero h1 {
      font-size: 2rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.4rem;
    }
    .se-hero p { color: var(--color-muted); margin: 0; }

    .se-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
      gap: 1.5rem;
    }
    .se-card {
      background: var(--color-card);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s, box-shadow 0.2s;
      color: inherit;
      text-decoration: none;
      display: flex;
      flex-direction: column;
    }
    .se-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      text-decoration: none;
    }
    .se-thumb {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
    }
    .se-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .se-overlay {
      position: absolute;
      inset: 0;
      padding: 0.75rem;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.4) 100%);
    }
    .se-emoji {
      font-size: 2rem;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    }
    .se-now {
      background: #ef4444;
      color: white;
      padding: 0.2rem 0.7rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);
    }
    .se-body {
      padding: 1.1rem 1.25rem 1.25rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .se-body h2 { margin: 0 0 0.4rem; font-size: 1.2rem; color: var(--color-text); }
    .se-body p {
      color: var(--color-muted);
      font-size: 0.9rem;
      flex: 1;
      margin-bottom: 0.5rem;
    }
    .se-count { color: var(--color-primary-dark); font-weight: 700; margin-top: auto; }
  </style>
</BaseLayout>
