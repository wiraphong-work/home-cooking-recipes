---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getCollection } from 'astro:content';
import { SEASONAL_COLLECTIONS, recipeMatchesCollection } from '../../utils/seasonal';

export async function getStaticPaths() {
  const all = await getCollection('recipes');
  return SEASONAL_COLLECTIONS.map((c) => {
    const recipes = all
      .filter((r) => recipeMatchesCollection(r.data, c))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
    return { params: { slug: c.slug }, props: { collection: c, recipes } };
  });
}

const { collection, recipes } = Astro.props;
const base = import.meta.env.BASE_URL;

function formatTime(iso: string): string {
  const m = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
  if (!m) return iso;
  const h = parseInt(m[1] || '0');
  const min = parseInt(m[2] || '0');
  if (h > 0 && min > 0) return `${h} ชม. ${min} นาที`;
  if (h > 0) return `${h} ชั่วโมง`;
  return `${min} นาที`;
}
---
<BaseLayout
  title={`${collection.title} (${recipes.length} สูตร) · ครัวบ้านๆ`}
  description={collection.description}
>
  <section class="se-detail-hero">
    <div class="container">
      <span class="se-emoji-big">{collection.emoji}</span>
      <h1>{collection.title}</h1>
      <p>{collection.description}</p>
      <div class="se-stat"><strong>{recipes.length}</strong> สูตรในคอลเลคชัน</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {recipes.length > 0 ? (
        <div class="grid">
          {recipes.map((r) => (
            <RecipeCard
              href={`${base}recipes/${r.slug}/`}
              title={r.data.title}
              description={r.data.description}
              image={r.data.image}
              cookTime={formatTime(r.data.totalTime)}
              servings={r.data.servings}
            />
          ))}
        </div>
      ) : (
        <div class="empty">
          <h2>ยังไม่มีสูตรในคอลเลคชันนี้</h2>
          <a href={`${base}seasonal/`}>ดูคอลเลคชันอื่น →</a>
        </div>
      )}
    </div>
  </section>

  <style>
    .se-detail-hero {
      background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
      padding: 2.5rem 1.25rem 2rem;
      text-align: center;
    }
    .se-emoji-big { font-size: 3rem; display: block; margin-bottom: 0.5rem; }
    .se-detail-hero h1 {
      font-size: 2rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.5rem;
    }
    .se-detail-hero p {
      color: var(--color-muted);
      max-width: 640px;
      margin: 0 auto 1rem;
    }
    .se-stat {
      display: inline-block;
      padding: 0.4rem 1rem;
      background: white;
      border-radius: 999px;
      font-size: 0.95rem;
    }
    .se-stat strong { color: var(--color-primary-dark); font-size: 1.1rem; }
    .empty { text-align: center; padding: 3rem 1rem; color: var(--color-muted); }
  </style>
</BaseLayout>
