---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_SLUGS, CATEGORY_INFO, categoryToSlug } from '../../utils/category';

export async function getStaticPaths() {
  const allRecipes = await getCollection('recipes');

  // หา categories ทั้งหมดที่มีในเว็บ
  const categoriesInUse = new Set(allRecipes.map((r) => r.data.category));

  return Array.from(categoriesInUse).map((category) => {
    const slug = categoryToSlug(category);
    const recipes = allRecipes
      .filter((r) => r.data.category === category)
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

    return {
      params: { slug },
      props: { category, recipes },
    };
  });
}

const { category, recipes } = Astro.props;
const base = import.meta.env.BASE_URL;
const info = CATEGORY_INFO[category] || { emoji: '🍽️', description: '' };

function formatTime(iso: string): string {
  const m = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
  if (!m) return iso;
  const h = parseInt(m[1] || '0');
  const min = parseInt(m[2] || '0');
  if (h > 0 && min > 0) return `${h} ชม. ${min} นาที`;
  if (h > 0) return `${h} ชั่วโมง`;
  return `${min} นาที`;
}
---
<BaseLayout
  title={`${category} - ${recipes.length} สูตร · ครัวบ้านๆ`}
  description={`รวม ${recipes.length} สูตร${category} · ${info.description}`}
>
  <section class="cat-hero">
    <div class="container">
      <h1>{info.emoji} {category}</h1>
      <p>{info.description}</p>
      <div class="cat-stats">
        <span><strong>{recipes.length}</strong> สูตรในหมวดนี้</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid">
        {recipes.map((recipe) => (
          <RecipeCard
            href={`${base}recipes/${recipe.slug}/`}
            title={recipe.data.title}
            description={recipe.data.description}
            image={recipe.data.image}
            cookTime={formatTime(recipe.data.totalTime)}
            servings={recipe.data.servings}
          />
        ))}
      </div>
    </div>
  </section>

  <style>
    .cat-hero {
      background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
      padding: 2.5rem 1.25rem 1.75rem;
      text-align: center;
    }
    .cat-hero h1 {
      font-size: 2.25rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.5rem;
    }
    .cat-hero p {
      color: var(--color-muted);
      max-width: 640px;
      margin: 0 auto 1rem;
      font-size: 1rem;
    }
    .cat-stats {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 1rem;
      background: white;
      border-radius: 999px;
      font-size: 0.95rem;
      color: var(--color-text);
    }
    .cat-stats strong { color: var(--color-primary-dark); font-size: 1.1rem; }

    @media (max-width: 640px) {
      .cat-hero h1 { font-size: 1.75rem; }
      .cat-hero p { font-size: 0.92rem; }
    }
  </style>
</BaseLayout>
