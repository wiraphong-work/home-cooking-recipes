---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getCollection } from 'astro:content';
import { pickRecipeOfTheDay } from '../utils/meal';

const base = import.meta.env.BASE_URL;

// ดึงสูตรทั้งหมดมาเรียงตามวันที่ลง
const allRecipes = await getCollection('recipes');
const sortedRecipes = allRecipes.sort((a, b) =>
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// เลือกเมนูประจำวัน (deterministic ตามวันที่)
const recipeOfTheDay = pickRecipeOfTheDay(sortedRecipes);

// แสดงวันที่เป็นภาษาไทย
const today = new Date();
const thaiDate = today.toLocaleDateString('th-TH', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// แปลง ISO duration เป็นข้อความอ่านง่าย (PT15M => 15 นาที)
function formatTime(isoDuration: string): string {
  const match = isoDuration.match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
  if (!match) return isoDuration;
  const hours = parseInt(match[1] || '0');
  const minutes = parseInt(match[2] || '0');
  if (hours > 0 && minutes > 0) return `${hours} ชม. ${minutes} นาที`;
  if (hours > 0) return `${hours} ชั่วโมง`;
  return `${minutes} นาที`;
}
---
<BaseLayout
  title="ครัวบ้านๆ · สูตรอาหารไทยทำง่ายที่บ้าน"
  description="รวมสูตรอาหารไทยทำง่าย พร้อมลิงก์ซื้อวัตถุดิบและอุปกรณ์ครัวในราคาย่อมเยา"
>
  <section class="hero">
    <div class="container">
      <h1>สูตรอาหารไทยทำง่าย 🍜</h1>
      <p>รวมสูตรอาหารไทยยอดนิยม ทำตามได้ที่บ้าน พร้อมลิงก์ซื้อวัตถุดิบและอุปกรณ์ในราคาดีๆ</p>
      <a href={`${base}random/`} class="hero-cta">🎲 วันนี้กินอะไรดี? สุ่มเลย</a>
    </div>
  </section>

  <!-- เมนูประจำวัน -->
  <section class="section daily-section">
    <div class="container">
      <div class="daily-head">
        <span class="daily-tag">⭐ เมนูประจำวันนี้</span>
        <span class="daily-date">{thaiDate}</span>
      </div>
      <a href={`${base}recipes/${recipeOfTheDay.slug}/`} class="daily-card">
        <div class="daily-img">
          <img src={recipeOfTheDay.data.image} alt={recipeOfTheDay.data.title} />
        </div>
        <div class="daily-body">
          <h2>{recipeOfTheDay.data.title}</h2>
          <p>{recipeOfTheDay.data.description}</p>
          <div class="daily-meta">
            <span>⏱️ {formatTime(recipeOfTheDay.data.totalTime)}</span>
            <span>🍽️ {recipeOfTheDay.data.servings} ที่</span>
            <span class="daily-cat">{recipeOfTheDay.data.category}</span>
          </div>
          <span class="daily-go">ดูสูตรเต็ม →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="section" id="recipes">
    <div class="container">
      <h2>สูตรแนะนำล่าสุด</h2>
      <div class="grid">
        {sortedRecipes.map((recipe) => (
          <RecipeCard
            href={`${base}recipes/${recipe.slug}/`}
            title={recipe.data.title}
            description={recipe.data.description}
            image={recipe.data.image}
            cookTime={formatTime(recipe.data.totalTime)}
            servings={recipe.data.servings}
          />
        ))}
      </div>
    </div>
  </section>

  <style>
    .hero-cta {
      display: inline-block;
      margin-top: 1.5rem;
      background: white;
      color: var(--color-primary-dark) !important;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      font-weight: 700;
      box-shadow: 0 4px 14px rgba(234, 88, 12, 0.2);
      transition: transform 0.15s, box-shadow 0.15s;
      text-decoration: none;
    }
    .hero-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(234, 88, 12, 0.3);
      text-decoration: none;
    }

    /* ===== Recipe of the Day ===== */
    .daily-section { padding: 2rem 0 1rem; }
    .daily-head {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .daily-tag {
      background: linear-gradient(135deg, #f97316, #ea580c);
      color: white;
      padding: 0.4rem 1rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.95rem;
    }
    .daily-date {
      color: var(--color-muted);
      font-size: 0.95rem;
    }

    .daily-card {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      background: white;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: transform 0.2s, box-shadow 0.2s;
      border: 2px solid var(--color-primary);
      text-decoration: none;
      color: inherit;
    }
    .daily-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(234, 88, 12, 0.18);
      text-decoration: none;
    }
    .daily-img {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #fee2c8;
    }
    .daily-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .daily-body {
      padding: 1.5rem 1.75rem;
      display: flex;
      flex-direction: column;
    }
    .daily-body h2 {
      margin: 0 0 0.5rem;
      font-size: 1.5rem;
      color: var(--color-text);
    }
    .daily-body p {
      color: var(--color-muted);
      margin-bottom: 0.85rem;
    }
    .daily-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      font-size: 0.88rem;
      color: var(--color-muted);
      align-items: center;
      margin-bottom: 1rem;
    }
    .daily-cat {
      background: #fff7ed;
      color: var(--color-primary-dark);
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 500;
    }
    .daily-go {
      color: var(--color-primary-dark);
      font-weight: 700;
      margin-top: auto;
    }

    @media (max-width: 720px) {
      .daily-card { grid-template-columns: 1fr; }
      .daily-img { aspect-ratio: 16 / 10; }
      .daily-body { padding: 1.1rem 1.25rem 1.25rem; }
      .daily-body h2 { font-size: 1.25rem; }
    }
  </style>
</BaseLayout>
